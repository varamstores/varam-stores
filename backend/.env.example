# Copy to .env and fill in. Never commit .env.

# Supabase (region eu-west-2 / London)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Database — percent-encode special characters in the password inside URLs
DB_PASSWORD=
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Tooling only (Supabase CLI). Never deploy.
SUPABASE_ACCESS_TOKEN=

# Stripe — TEST keys only (added in Phase 6)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (order & account emails). The sending domain must be verified in Resend.
# RESEND_API_KEY=re_...

# After adding or changing any server-side key above: npm run vault:sync  (copies them into Supabase Vault)
